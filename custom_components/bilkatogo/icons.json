{
  "entity": {
    "binary_sensor": {
      "ready_for_pickup": {
        "default": "mdi:basket-outline",
        "state": {
          "on": "mdi:basket-check"
        }
      }
    },
    "sensor": {
      "order_status": {
        "default": "mdi:basket",
        "state": {
          "processing": "mdi:progress-clock",
          "received": "mdi:basket-outline",
          "packed": "mdi:basket-check",
          "picked_up": "mdi:check-circle-outline",
          "not_collected": "mdi:basket-off",
          "cancelled": "mdi:close-circle-outline",
          "sold_out": "mdi:basket-remove",
          "unrecognized": "mdi:help-circle-outline"
        }
      },
      "substitutions": {
        "default": "mdi:swap-horizontal"
      },
      "missing_items": {
        "default": "mdi:cart-remove"
      },
      "pickup_code": {
        "default": "mdi:numeric"
      },
      "pickup_point": {
        "default": "mdi:store-marker"
      }
    }
  },
  "services": {
    "add_to_cart": {
      "service": "mdi:cart-plus"
    },
    "search": {
      "service": "mdi:magnify"
    }
  }
}
